ALERTS_ENV=dev
ALERTS_APP_HOST=0.0.0.0
ALERTS_APP_PORT=9100
ALERTS_LOG_LEVEL=INFO
ALERTS_REQUEST_TIMEOUT_SECONDS=10

# Telegram
ALERTS_BOT_TOKEN=replace_me
ALERTS_CHAT_ID=-1234567890
TELEGRAM_PROXY_URL=

# Shared secret for clients
ALERTS_TOKEN=replace_me

# История: локально alerts.db; systemd задаёт /var/lib/alertsbot/alerts.db.
# Раскомментируйте только для изменения стандартного пути.
# ALERTS_DB_PATH=/var/lib/alertsbot/alerts.db
# Список прокси имеет приоритет над одиночным TELEGRAM_PROXY_URL.
TELEGRAM_PROXY_URLS=
TELEGRAM_PROXY_CIRCUIT_BREAKER_SECONDS=120
