[Unit]
Description=Пересылка истории alertsbot во вкладку tpanel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=server
StateDirectory=alerts-tab-forwarder
StateDirectoryMode=0700
UMask=0077
Environment=ALERTS_TAB=admin/alerts
ExecStart=/usr/local/bin/alerts-tab-forwarder
TimeoutStartSec=90s
# Пульс обновляется только после успешного прохода, включая пустой.
ExecStartPost=+/bin/sh -c 'umask 022; f=/var/lib/prometheus/node-exporter/alerts_tab_forwarder.prom; echo "alerts_tab_forwarder_last_success_timestamp_seconds $$(date +%%s)" > $$f.tmp && mv $$f.tmp $$f'
