[Unit]
Description=alertsbot
After=network.target

[Service]
Type=simple
User=alertsbot
Group=alertsbot
WorkingDirectory=/alertsbot
EnvironmentFile=/alertsbot/.env
# Ровно один воркер: circuit breaker и идемпотентность по event_id живут в памяти процесса.
ExecStart=/alertsbot/.venv/bin/uvicorn alertsbot.app:app --host ${ALERTS_APP_HOST} --port ${ALERTS_APP_PORT} --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
