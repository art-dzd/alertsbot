[Unit]
Description=alertsbot
Requires=alertsbot.socket
After=network.target alertsbot.socket
# Запуски от входящих соединений не упираются в лимит стартов: порт не закроется.
StartLimitIntervalSec=0

[Service]
Type=simple
User=alertsbot
Group=alertsbot
WorkingDirectory=/alertsbot
EnvironmentFile=/alertsbot/.env
Environment=ALERTS_DB_PATH=/var/lib/alertsbot/alerts.db
StateDirectory=alertsbot
StateDirectoryMode=0700
UMask=0077
# Ровно один воркер: circuit breaker и идемпотентность по event_id живут в памяти процесса.
# Слушающий сокет приходит от alertsbot.socket как fd 3.
ExecStart=/alertsbot/.venv/bin/uvicorn alertsbot.app:app --fd 3 --workers 1 --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
